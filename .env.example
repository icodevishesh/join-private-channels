# Spaceship
# Only what's needed to start. Everything else (Discord, Telegram channel,
# Elefin, public URL, admins) is managed in the admin panel at /admin.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Web server: admin panel + Discord login callback
WEB_PORT=3000

# Signs admin login sessions (any long random string). Changing it signs every admin out.
ADMIN_SESSION_SECRET=

# Optional, first install only: copied into the admin panel settings on first start
# if those settings are still empty. Safe to remove afterwards.
# ELEFIN_TOKEN_SEED=
# PUBLIC_URL=https://bot.example.com
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_CLIENT_SECRET=
